{
  "name": "prism-dev-pack",
  "displayName": "Prism Dev Pack",
  "description": "Visual readability, semantic autocompletion, column metadata, and Go-to-Definition for SQL & dbt.",
  "version": "1.2.0",
  "publisher": "elambert",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Extension Packs"
  ],
  "keywords": [
    "sql",
    "dbt",
    "zip",
    "jinja",
    "cte",
    "autocomplete",
    "lineage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EdouardLambert/prism-dev-pack.git"
  },
  "extensionPack": [
    "elambert.sql-prism",
    "elambert.dbt-prism",
    "elambert.zip-prism"
  ],
  "files": [
    "assets/**",
    "LICENSE*",
    "README.md",
    "package.json"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:sql": "npm run build --workspace=sql-prism",
    "build:dbt": "npm run build --workspace=dbt-prism",
    "build:zip": "npm run build --workspace=zip-prism",
    "build": "npm run build:sql && npm run build:dbt && npm run build:zip",
    "typecheck": "tsc -p packages/sql-prism/tsconfig.json && tsc -p packages/dbt-prism/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:pack": "vsce package --no-dependencies",
    "package:sql": "cd packages/sql-prism && npx @vscode/vsce package --no-dependencies",
    "package:dbt": "cd packages/dbt-prism && npx @vscode/vsce package --no-dependencies",
    "package:zip": "cd packages/zip-prism && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
